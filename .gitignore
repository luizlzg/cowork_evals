# Python environments
.venv/
.venv_cowork/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Build products.
dist/

# Eval output. Slow and costly to produce, never committed. `evals/results/` is where the
# harness writes when it is run by hand with no --output-dir; the pattern is anchored to that
# directory, because a bare `results/` also swallows the fixture documents under tests/data/.
logs/
evals/results/
tmp/

# Runtime staged into a plugin under test for the length of a run.
# See docs/staged_runtime.md
.cowork-runtime/

# Local machine state
.claude/settings.local.json

# The shipped skills, copied in by scripts/dev_skills.sh. The copy under
# src/cowork_evals/data/skills/ is the one source. See docs/library.md.
.claude/skills/

# Configuration. Names a CoWork profile, which is an identifier.
# See README.md, the public repository rule.
cowork_evals.yaml
.DS_Store
